# SSH-IMPORT-FORWARDS fixture: one line per edge case. Nothing here is ever connected.
Host acme-db
  HostName db.acme.invalid
  User ops
  ProxyJump acme-jump
  LocalForward 5432 db:5432
  LocalForward *:8081 web:80
  LocalForward 8080 web2:80
  RemoteForward 9001 10.0.0.5:22
  RemoteForward 9000 localhost:3000
  DynamicForward 1080
  LocalForward /tmp/a.sock /tmp/b.sock
  RemoteForward 1081
  ExitOnForwardFailure yes
Host acme-jump
  HostName jump.acme.invalid
Host acme-web acme-api
  HostName %h.acme.invalid
Host acme-*
  LocalForward [::1]:8443 [fd00::1]:443
