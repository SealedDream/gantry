<Window x:Class="Minimal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Minimal">
    <StackPanel x:Name="Host" Padding="24" Spacing="8">
        <StackPanel.Resources>
            <Style x:Key="NoTrans" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="CP" Background="{TemplateBinding Background}" Content="{TemplateBinding Content}" Padding="11,5" CornerRadius="4">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CP.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CP.Background" Value="{ThemeResource ButtonBackgroundPressed}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WithTrans" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="CP" Background="{TemplateBinding Background}" Content="{TemplateBinding Content}" Padding="11,5" CornerRadius="4">
                                <ContentPresenter.BackgroundTransition><BrushTransition Duration="0:0:0.083" /></ContentPresenter.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CP.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CP.Background" Value="{ThemeResource ButtonBackgroundPressed}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </StackPanel.Resources>
        <Button x:Name="AddText" Content="Add text" Click="AddText_Click" AutomationProperties.Name="Add text" />
        <Button x:Name="DisableMe" Content="Disable me" Click="DisableMe_Click" AutomationProperties.Name="Disable me" />
        <Button Content="Noop" AutomationProperties.Name="Noop" />
        <Button Content="NoTrans" Style="{StaticResource NoTrans}" AutomationProperties.Name="NoTrans" />
        <Button Content="WithTrans" Style="{StaticResource WithTrans}" AutomationProperties.Name="WithTrans" />
        <TextBlock Text="Hello" />
        <TabView x:Name="Tabs" Visibility="Collapsed" IsAddTabButtonVisible="False" Height="200">
            <TabViewItem Header="Details" IsClosable="False"><TextBlock Text="tab content" /></TabViewItem>
        </TabView>
        <!-- MINIMAL_COMMANDBAR=show: a stock CommandBar (AppBarButton templates contain BrushTransition). -->
        <CommandBar x:Name="Bar" Visibility="Collapsed" DefaultLabelPosition="Right" HorizontalAlignment="Left">
            <AppBarButton Icon="Add" Label="Bar add" AutomationProperties.Name="Bar add" />
            <AppBarButton Icon="Delete" Label="Bar delete" AutomationProperties.Name="Bar delete" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Secondary one" />
                <AppBarButton Label="Secondary two" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </StackPanel>
</Window>
