<Project Sdk="Microsoft.NET.Sdk">
  <!-- B5: console checks of the before-connect gate verdicts and the Connect All multi-host batch (HookGate.cs).
       No window, no core, no network. Run: hook-gate-console-test.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Tests</RootNamespace>
    <AssemblyName>hook-gate-console</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\HookGate.cs" Link="HookGate.cs" />
  </ItemGroup>
</Project>
