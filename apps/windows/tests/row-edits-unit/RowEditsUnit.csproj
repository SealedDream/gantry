<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the library tree's row edits (WIN-TREE-REBUILD, Native Windows): the in-place edits a rebuild
    makes instead of replacing every shown row. A plain console program: no window, no NuGet packages. It compiles
    the app's own RowEdits.cs. Run in this folder: dotnet run -c Release (exit code = number of failures).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Shell.Tests</RootNamespace>
    <AssemblyName>RowEditsUnit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\RowEdits.cs" Link="RowEdits.cs" />
  </ItemGroup>
</Project>
