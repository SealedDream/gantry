<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for Settings › General › Window at launch (WindowLaunch.cs): clamping to the screen and the fallback to the
    main screen when a saved monitor is gone. A plain console program: no window, no NuGet packages, runs on any OS.
    Run in this folder: dotnet run -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Shell.Tests</RootNamespace>
    <AssemblyName>WindowLaunchUnit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\WindowLaunch.cs" Link="WindowLaunch.cs" />
  </ItemGroup>
</Project>
