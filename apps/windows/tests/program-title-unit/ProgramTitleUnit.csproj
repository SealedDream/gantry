<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the program title as a tab name (ProgramTitle.cs) (Native Windows). A plain console
    program: no window, no NuGet packages. It compiles the app's own ProgramTitle.cs.
    Run in this folder: dotnet run -c Release (exit code = number of failures).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Shell.Tests</RootNamespace>
    <AssemblyName>ProgramTitleUnit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ProgramTitle.cs" Link="ProgramTitle.cs" />
  </ItemGroup>
</Project>
