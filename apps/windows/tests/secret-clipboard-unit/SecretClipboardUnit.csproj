<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the "Clear copied passwords after" setting (A3-S1, Native Windows). A plain console program: no window,
    no desktop session, no NuGet packages. It compiles the app's own rule (SecretClipboardLifetime.cs) and reads
    settings.json through bastion_cabi.dll, as the app does at copy time.

    Run in this folder: dotnet build -c Release, then
          bin\Release\net10.0\SecretClipboardUnit.exe
    It finds bastion_cabi.dll itself (BASTION_CABI_DLL, else apps\windows\native\ or core-cabi\target\release\ above
    the program); a path given as the only argument wins.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Shell.Tests</RootNamespace>
    <AssemblyName>SecretClipboardUnit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SecretClipboardLifetime.cs" Link="SecretClipboardLifetime.cs" />
  </ItemGroup>
</Project>
