<Project Sdk="Microsoft.NET.Sdk">
  <!-- LOCK-CREDENTIALS-REOPEN: the inspector's credential labels never open a locked vault. dotnet run -project tests/vault-labels -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../VaultLabels.cs" />
  </ItemGroup>
</Project>
