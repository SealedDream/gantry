<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the Icon and properties page rules (PARITY-01 rows 8 and 9, Native Windows). A plain console
    program: no window, no NuGet packages. It compiles the app's own ItemExtrasEdits.cs.
    Run in this folder: dotnet run -c Release (exit code = number of failures).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Shell.Tests</RootNamespace>
    <AssemblyName>ItemExtrasUnit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ItemExtrasEdits.cs" Link="ItemExtrasEdits.cs" />
  </ItemGroup>
</Project>
