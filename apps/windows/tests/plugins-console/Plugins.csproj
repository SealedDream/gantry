<Project Sdk="Microsoft.NET.Sdk">
  <!-- PLUG-06b: console checks of the Plugins page words and of the core's plugin exports
       through bastion_cabi (C ABI 120). No window, no network. Run: plugins-console-test.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Tests</RootNamespace>
    <AssemblyName>plugins-console</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;..\a1-logins-console\Stubs.cs" />
    <!-- The app's own interop sources, compiled as they are: the test exercises the code the app ships. -->
    <Compile Include="..\..\Interop\*.cs" Exclude="..\..\Interop\HelloInterop.cs" LinkBase="Interop" />
    <Compile Include="..\..\AppRename.cs" Link="AppRename.cs" />
    <Compile Include="..\..\ItemExtrasEdits.cs" Link="ItemExtrasEdits.cs" />
    <!-- Two small app files the interop sources name (test hooks are off in this build). -->
    <Compile Include="..\..\TestHooks.cs;..\..\SecretClipboardLifetime.cs;..\..\ItemExtrasEdits.cs" />
    <!-- LOG-NATIVE-01 items 4 and 7: the transcript reader and the diagnostics bundle (no WinUI in either). -->
    <Compile Include="..\..\TranscriptText.cs;..\..\Diagnostics.cs" />
    <!-- PrefsNative names LoginReuseTimes (main broke this build without it). -->
    <Compile Include="..\..\LoginReuseTimes.cs" />
    <Compile Include="..\activity-console\LeakProbeStub.cs" />
    <Compile Include="..\..\DesktopFit.cs;..\..\ExternalProviders.cs" />
  </ItemGroup>
</Project>
