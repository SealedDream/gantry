<Project Sdk="Microsoft.NET.Sdk">
  <!-- PLUG-VIEW-WIN (Native Windows): console checks of the plugin view model (PluginViewModel.cs): updates, patches,
       dialogs, confirm, rows, children, completions and the events it sends. Pure: no core, no window, no network.
       Run: plugin-view-console-test.ps1, or dotnet run. Also runs on the Mac (dotnet 10). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Tests</RootNamespace>
    <AssemblyName>plugin-view-console</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\PluginViewModel.cs" Link="PluginViewModel.cs" />
    <Compile Include="..\..\Interop\HighlightNative.cs" Link="Interop\HighlightNative.cs" />
    <Compile Include="..\sql-editor-console\LibraryClientStub.cs" Link="LibraryClientStub.cs" />
  </ItemGroup>
</Project>
