<Project Sdk="Microsoft.NET.Sdk">
  <!-- B11: console checks of the tab preview and overview rules (TabPreviewRules.cs), compiled as the app ships them.
       No window, no core, no network. Run: see tab-preview-console-test.ps1 (any OS with the .NET 8 SDK). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Tests</RootNamespace>
    <AssemblyName>tab-preview-console</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\TabPreviewRules.cs" Link="TabPreviewRules.cs" />
  </ItemGroup>
</Project>
