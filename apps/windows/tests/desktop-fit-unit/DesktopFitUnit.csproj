<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the Fit to tab / Fixed size / Scale rules (RDP-VNC-FIT, Native Windows). A plain console program: no
    window, no NuGet packages. It compiles the app's own DesktopFit.cs.
    Run in this folder: dotnet run -c Release (exit code = number of failures).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Shell.Tests</RootNamespace>
    <AssemblyName>DesktopFitUnit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\DesktopFit.cs" Link="DesktopFit.cs" />
  </ItemGroup>
</Project>
