<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the spare TSF edit contexts (ImeContextPool.cs, WIN-SHELL-LEAK) (Native Windows). A plain console
    program: no window, no NuGet packages. It compiles the app's own ImeContextPool.cs.
    Run in this folder: dotnet run -c Release (exit code = number of failures).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Shell.Tests</RootNamespace>
    <AssemblyName>ImeContextPoolUnit</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ImeContextPool.cs" Link="ImeContextPool.cs" />
  </ItemGroup>
</Project>
