<Project Sdk="Microsoft.NET.Sdk">
  <!-- SEC-1: lock during a KeePass import must not free the vault under the worker. Compiles NativeLifetime.cs as the
       app ships it, with a fake free. No window, no core, no network. Run: credential-lease-console-test.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Tests</RootNamespace>
    <AssemblyName>credential-lease-console</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Interop\NativeLifetime.cs" Link="NativeLifetime.cs" />
  </ItemGroup>
</Project>
