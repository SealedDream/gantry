<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owner 2026-11-15: console checks of the accent fill contrast rule (AccentContrast.cs), compiled as the app ships them.
       No window, no core, no network. Run: see accent-contrast-console-test.ps1 (any OS with the .NET 8 SDK). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bastion.Tests</RootNamespace>
    <AssemblyName>accent-contrast-console</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\AccentContrast.cs" Link="AccentContrast.cs" />
  </ItemGroup>
</Project>
