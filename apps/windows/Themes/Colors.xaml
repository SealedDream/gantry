<!--
  Bastion colour tokens. Every colour the shell paints comes from here; MainWindow.xaml has no colour literals.

  Surfaces (both themes keep the same hierarchy):
    Shell    window base: toolbar, navigation pane, status bar (Mica shows through it on Windows 11).
    Layer    the workspace and inspector, one step lighter, with a subtle stroke where it meets the shell.
    Session  terminal surface. Equal to the app theme's terminal background (Match app theme, the default): Bastion
             Light 0xFAFAFA in the light theme, Bastion Dark 0x1C1C1E in the dark, so no dark frame rings a light terminal.
  Text and critical colours alias the stock Fluent theme brushes; the accent comes from Accent.xaml (the chosen
  appearance.accent). High contrast keeps the system palette. HighContrast maps every token to a system colour.

  Interaction brushes are plain colours applied by visual-state setters (no BrushTransition, no animation):
  on the Windows 10 development machine any running composition animation keeps a CPU core busy
  (docs/TESTING.md, "WinUI CPU spin").
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="LayerStrokeBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E8E8E8" />
            <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SubtlePressedBrush" Color="#06000000" />
            <SolidColorBrush x:Key="SubtleHoverForegroundBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="SubtlePressedForegroundBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="SplitterHoverBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DialogCommandBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="DialogStrokeBrush" Color="#C9C9C9" />
            <SolidColorBrush x:Key="SessionBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="SessionForegroundBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SessionSecondaryForegroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="SessionHoverBrush" Color="#0F000000" />
            <!-- Selected tab: a light card in the light theme (as on the Mac), the session colour in dark. -->
            <SolidColorBrush x:Key="ActiveTabBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ActiveTabForegroundBrush" Color="#1B1B1B" />
            <!-- System title bar (AppWindow.TitleBar, opaque colours only); its background is ShellBackgroundBrush. -->
            <Color x:Key="TitleBarForegroundColor">#1B1B1B</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#8A8A8A</Color>
            <Color x:Key="TitleBarButtonHoverColor">#E4E4E4</Color>
            <Color x:Key="TitleBarButtonPressedColor">#D6D6D6</Color>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000" />
            <!-- UI-01 tree status marks; each also has a shape and words. -->
            <SolidColorBrush x:Key="StatusConnectedBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="StatusConnectingBrush" Color="#B45309" />
            <SolidColorBrush x:Key="StatusFailedBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#72000000" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C000000" />
            <!-- Accent.xaml's brushes (the chosen accent). -->
            <StaticResource x:Key="AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="AccentTextBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentTextHoverBrush" ResourceKey="AccentTextFillColorSecondaryBrush" />
            <StaticResource x:Key="AccentTextPressedBrush" ResourceKey="AccentTextFillColorTertiaryBrush" />
            <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />
            <!-- Session title bar status dot (Codex Y06); disconnected uses CriticalBrush. -->
            <SolidColorBrush x:Key="SessionConnectedBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="SessionConnectingBrush" Color="#9D5D00" />        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#272727" />
            <SolidColorBrush x:Key="LayerStrokeBrush" Color="#141414" />
            <SolidColorBrush x:Key="DividerBrush" Color="#333333" />
            <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SubtleHoverForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SubtlePressedForegroundBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="SplitterHoverBrush" Color="#4A4A4A" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
            <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="DialogCommandBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="DialogStrokeBrush" Color="#444444" />
            <SolidColorBrush x:Key="SessionBackgroundBrush" Color="#1C1C1E" />
            <SolidColorBrush x:Key="SessionForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SessionSecondaryForegroundBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="SessionHoverBrush" Color="#1AFFFFFF" />
            <!-- Selected tab: a light card in the light theme (as on the Mac), the session colour in dark. -->
            <SolidColorBrush x:Key="ActiveTabBrush" Color="#1C1C1E" />
            <SolidColorBrush x:Key="ActiveTabForegroundBrush" Color="#FFFFFF" />
            <!-- System title bar (AppWindow.TitleBar, opaque colours only); its background is ShellBackgroundBrush. -->
            <Color x:Key="TitleBarForegroundColor">#FFFFFF</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#9A9A9A</Color>
            <Color x:Key="TitleBarButtonHoverColor">#2E2E2E</Color>
            <Color x:Key="TitleBarButtonPressedColor">#393939</Color>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
            <!-- UI-01 tree status marks; each also has a shape and words. -->
            <SolidColorBrush x:Key="StatusConnectedBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="StatusConnectingBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="StatusFailedBrush" Color="#F87171" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF" />
            <!-- Accent.xaml's brushes (the chosen accent). -->
            <StaticResource x:Key="AccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="AccentTextBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="AccentTextHoverBrush" ResourceKey="AccentTextFillColorSecondaryBrush" />
            <StaticResource x:Key="AccentTextPressedBrush" ResourceKey="AccentTextFillColorTertiaryBrush" />
            <SolidColorBrush x:Key="CriticalBrush" Color="#FF99A4" />
            <!-- Session title bar status dot (Codex Y06); disconnected uses CriticalBrush. -->
            <SolidColorBrush x:Key="SessionConnectedBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="SessionConnectingBrush" Color="#FCE100" />        </ResourceDictionary>

        <!-- High contrast: system colours only, so the user's contrast theme decides everything. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LayerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LayerStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SubtleHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SubtlePressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SubtleHoverForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SubtlePressedForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SplitterHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ScrimBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.6" />
            <SolidColorBrush x:Key="DialogBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DialogCommandBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DialogStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SessionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SessionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SessionSecondaryForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SessionHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <!-- Selected tab: a light card in the light theme (as on the Mac), the session colour in dark. -->
            <SolidColorBrush x:Key="ActiveTabBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ActiveTabForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- UI-01 tree status marks; each also has a shape and words. -->
            <SolidColorBrush x:Key="StatusConnectedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusConnectingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusFailedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AccentTextHoverBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AccentTextPressedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="CriticalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <!-- Session title bar status dot (Codex Y06); disconnected uses CriticalBrush. -->
            <SolidColorBrush x:Key="SessionConnectedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SessionConnectingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
