<!--
  Icon glyphs. FontIcons use Segoe Fluent Icons on Windows 11 and Segoe MDL2 Assets on Windows 10 (same code
  points). Every glyph below was rendered and checked on Windows 10 (19045). The MDL2 folder glyphs (E8B7 Folder,
  E8F4 NewFolder) draw page shapes on Windows 10, so folders are vector icons instead: AppIcon.cs
  (Kind="Folder" / "FolderAdd"). No emoji anywhere. GlyphFavorite, GlyphSettings, GlyphKeyboard, GlyphConnect and GlyphWorkspace
  (2026-11-03) were checked on Windows 11 only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="SymbolFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets, ms-appx:///Fonts/JetBrainsMonoNerdFontMono-Regular.ttf#JetBrainsMono Nerd Font Mono</FontFamily>
