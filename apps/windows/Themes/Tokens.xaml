<!--
  Bastion design tokens: spacing, sizes, radii, strokes and the type ramp. Colours live in Colors.xaml.

  Rules
  - Spacing comes from one scale: 4 / 8 / 12 / 16 / 24 / 32. Dense regions (tree, toolbar, inspector rows) use 4-12.
  - Two radii: 4 for controls and tabs, 8 for the workspace layer and dialogs (dialog sections use 7 = 8 minus the
    1 px card border, so they sit flush inside it).
  - Control height 32, compact 28 (tree rows are the stock 28 px TreeViewItem). Icons are 16 px.
  - Four text sizes only: Caption 12, Body 14, BodyStrong 14 semibold, Subtitle 20 (dialog titles). Hierarchy
    inside the shell comes from weight and the three text colours, not from more sizes.
  - Font: Segoe UI Variable Text on Windows 11, Segoe UI on Windows 10 (the second family is the fallback).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Type -->
    <FontFamily x:Key="BastionFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Stock controls (TextBox, ComboBox, menus, buttons) read this key, so they use the same family. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="SubtitleFontSize">20</x:Double>

    <!-- Spacing scale -->
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space32">32</x:Double>

    <!-- Paddings and margins built from the scale -->
    <Thickness x:Key="ToolbarPadding">8,4,8,4</Thickness>
    <!-- The toolbar is the title bar (MainWindow.TitleBar.cs): at least the height of the tall system caption buttons. -->
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <Thickness x:Key="ToolbarButtonPadding">8,0,10,0</Thickness>
    <Thickness x:Key="IconButtonPadding">8,0,8,0</Thickness>
    <Thickness x:Key="ToolbarSeparatorMargin">4,8,4,8</Thickness>
    <Thickness x:Key="NavSearchMargin">8,4,8,8</Thickness>
    <Thickness x:Key="NavBottomBarPadding">8,4,8,4</Thickness>
    <Thickness x:Key="NavMessageMargin">16,8,16,8</Thickness>
    <Thickness x:Key="SearchBoxPadding">32,5,8,6</Thickness>
    <Thickness x:Key="SearchIconMargin">10,0,0,0</Thickness>
    <Thickness x:Key="SearchConnectPadding">10,5,8,6</Thickness>
    <!-- Compact header: the library switcher's inset from the divider line on its right. -->
    <Thickness x:Key="CompactLibraryMargin">0,0,8,0</Thickness>
    <Thickness x:Key="TabStripPadding">8,0,8,0</Thickness>
    <Thickness x:Key="TabSelectPadding">12,0,6,0</Thickness>
    <Thickness x:Key="TabClosePadding">0</Thickness>
    <Thickness x:Key="TabCloseMargin">0,0,6,0</Thickness>
    <Thickness x:Key="SessionPadding">8,6,8,6</Thickness>
    <Thickness x:Key="EmptyStatePadding">24</Thickness>
    <Thickness x:Key="InspectorHeaderPadding">16,12,8,12</Thickness>
    <Thickness x:Key="InspectorBodyPadding">16,12,16,16</Thickness>
    <Thickness x:Key="InspectorActionsMargin">-8,8,0,0</Thickness>
    <Thickness x:Key="InspectorSectionMargin">0,16,0,8</Thickness>
    <Thickness x:Key="InspectorFirstSectionMargin">0,0,0,8</Thickness>
    <!-- A button or notice under an inspector section's rows. -->
    <Thickness x:Key="InspectorButtonMargin">0,8,0,0</Thickness>
    <!-- Notes box: about three lines before it grows. -->
    <x:Double x:Key="NotesMinHeight">72</x:Double>
    <Thickness x:Key="DialogPadding">24</Thickness>
    <!-- Space kept between a dialog and the window edge when the dialog is as tall as the window. -->
    <Thickness x:Key="DialogOuterMargin">16</Thickness>
    <Thickness x:Key="DialogCaptionMargin">0,4,0,0</Thickness>
    <Thickness x:Key="DialogBodyMargin">0,16,0,0</Thickness>
    <Thickness x:Key="FieldMessageMargin">0,4,0,0</Thickness>
    <Thickness x:Key="NoThickness">0</Thickness>

    <!-- Strokes -->
    <Thickness x:Key="HairlineThickness">1</Thickness>
    <Thickness x:Key="LayerBorderThickness">1,1,0,1</Thickness>
    <Thickness x:Key="TopDividerThickness">0,1,0,0</Thickness>
    <Thickness x:Key="BottomDividerThickness">0,0,0,1</Thickness>
    <Thickness x:Key="LeftDividerThickness">1,0,0,0</Thickness>
    <x:Double x:Key="HairlineWidth">1</x:Double>

    <!-- Radii -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="LayerCornerRadius">8,0,0,8</CornerRadius>
    <CornerRadius x:Key="TabCornerRadius">4,4,0,0</CornerRadius>
    <CornerRadius x:Key="DialogTopCornerRadius">7,7,0,0</CornerRadius>
    <CornerRadius x:Key="DialogBottomCornerRadius">0,0,7,7</CornerRadius>

    <!-- Sizes -->
    <x:Double x:Key="IconSize">16</x:Double>
    <x:Double x:Key="SmallIconSize">12</x:Double>
    <x:Double x:Key="TabCloseGlyphSize">10</x:Double>
    <x:Double x:Key="EmptyStateIconSize">32</x:Double>
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="CompactControlHeight">28</x:Double>
    <!-- 2 px over MinHitTarget: centred in the tab on a half pixel it still measures >= 24 (layout-fit, 100% dark). -->
    <x:Double x:Key="TabCloseSize">26</x:Double>
    <x:Double x:Key="TabMinWidth">112</x:Double>
    <!-- Width the title bar keeps for the tab bar before toolbar labels fold to icons (two tabs). -->
    <x:Double x:Key="TabBarMinWidth">240</x:Double>
    <x:Double x:Key="TabMaxWidth">220</x:Double>
    <!-- Smallest a tab gets, only on a strip too narrow for a group chip plus a TabMinWidth tab: icon, a few letters, close. -->
    <x:Double x:Key="TabNarrowMinWidth">56</x:Double>
    <!-- Vertical tab list (tabs.vertical): the same width as Native Mac's list. -->
    <x:Double x:Key="VerticalTabsWidth">220</x:Double>
    <Thickness x:Key="VerticalTabsPadding">8,6,8,6</Thickness>
    <!-- Smallest pointer target (WCAG 2.2 target size, 24 px); the status bar is exactly this tall. -->
    <x:Double x:Key="MinHitTarget">24</x:Double>
    <!-- Text boxes (and NumberBox, whose inline spin buttons take the box's inner height) are MinHitTarget plus border
         and padding (9 px) tall, so those buttons are at least 24 px. The stock value is 32 (23 px buttons). -->
    <x:Double x:Key="TextControlThemeMinHeight">33</x:Double>
    <x:Double x:Key="SplitterWidth">5</x:Double>
    <Thickness x:Key="StatusButtonPadding">4,2,4,2</Thickness>
    <x:Double x:Key="SplitterLineWidth">2</x:Double>
    <GridLength x:Key="NavPaneWidth">260</GridLength>
    <x:Double x:Key="NavPaneWidthValue">260</x:Double>
    <x:Double x:Key="NavPaneMinWidth">200</x:Double>
    <x:Double x:Key="NavPaneMaxWidth">480</x:Double>
    <GridLength x:Key="InspectorWidth">300</GridLength>
    <x:Double x:Key="InspectorWidthValue">300</x:Double>
    <x:Double x:Key="InspectorMinWidth">240</x:Double>
    <x:Double x:Key="InspectorMaxWidth">520</x:Double>
    <GridLength x:Key="InspectorLabelColumnWidth">88</GridLength>
    <x:Double x:Key="EmptyStateMaxWidth">480</x:Double>
    <x:Double x:Key="DialogWidth">400</x:Double>
    <x:Double x:Key="DialogWideWidth">480</x:Double>
    <x:Double x:Key="DialogMinWidth">320</x:Double>
    <x:Double x:Key="DialogMaxWidth">548</x:Double>
    <x:Double x:Key="DialogButtonMinWidth">96</x:Double>
    <x:Double x:Key="FieldNarrowWidth">136</x:Double>
    <x:Double x:Key="QuickConnectFieldWidth">320</x:Double>
    <!-- Window: default and minimum size in effective pixels; below the widths the side panes auto-hide. -->
    <x:Double x:Key="WindowDefaultWidth">1280</x:Double>
    <x:Double x:Key="WindowDefaultHeight">800</x:Double>
    <x:Double x:Key="WindowMinWidth">640</x:Double>
    <x:Double x:Key="WindowMinHeight">420</x:Double>
    <!-- Settings window (SettingsWindow.cs): default and minimum size; the sidebar collapses to a list below the narrow width. -->
    <x:Double x:Key="SettingsWindowWidth">960</x:Double>
    <x:Double x:Key="SettingsWindowHeight">680</x:Double>
    <x:Double x:Key="SettingsWindowMinWidth">560</x:Double>
    <x:Double x:Key="SettingsWindowMinHeight">400</x:Double>
    <x:Double x:Key="InspectorAutoHideWidth">900</x:Double>
    <x:Double x:Key="NavAutoHideWidth">720</x:Double>
    <x:Double x:Key="WorkspaceMinWidth">320</x:Double>

    <!-- Type ramp -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BastionFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextLineBounds" Value="Full" />
    </Style>
    <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="CaptionTertiaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BastionFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="BodySecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Inline validation under a field (Forms.cs). -->
    <Style x:Key="FieldErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource CriticalBrush}" />
    </Style>
    <Style x:Key="FieldErrorIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource CriticalBrush}" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SmallIconSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BastionFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
