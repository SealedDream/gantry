<?xml version="1.0" encoding="utf-8"?>
<!-- The Credentials section pinned at the bottom of the navigation pane (Native Mac CredentialsSection). One collapsible
     heading; under it "Locked" while the vault is closed, else the vault's folders and credentials. Names and user names
     only: secrets never reach this control. Its logic (menus, drag and drop, unlock) stays in MainWindow.CredentialsTree.cs. -->
<UserControl
    x:Class="Bastion.Shell.CredentialsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bastion.Shell"
    AutomationProperties.Name="Credentials section">
    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <TreeView x:Name="Rows" Background="Transparent" SelectionMode="Single"
                  CanDragItems="False" CanReorderItems="False" AllowDrop="True"
                  DragOver="Rows_DragOver" Drop="Rows_Drop"
                  ContextRequested="Rows_ContextRequested" ItemInvoked="Rows_ItemInvoked"
                  Expanding="Rows_Expanding" Collapsed="Rows_Collapsed"
                  AutomationProperties.Name="Credentials">
            <TreeView.ItemContainerTransitions>
                <TransitionCollection />
            </TreeView.ItemContainerTransitions>
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="RowMenu" Opening="RowMenu_Opening" />
            </FlyoutBase.AttachedFlyout>
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:TreeItem">
                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind Expanded}"
                                  DataContextChanged="Row_DataContextChanged"
                                  CanDrag="True" DragStarting="Row_DragStarting" DropCompleted="Row_DropCompleted"
                                  AllowDrop="True" DragOver="Row_DragOver" Drop="Row_Drop"
                                  AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Description}"
                                  local:LazyToolTip.Text="{x:Bind RowTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                            <Grid Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" VerticalAlignment="Center">
                                <local:ConnectionIcon IconId="{x:Bind ArtId}" Visibility="{x:Bind ArtVisibility}" AutomationProperties.AccessibilityView="Raw" />
                                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource SymbolFontFamily}" FontSize="{StaticResource IconSize}"
                                          Foreground="{x:Bind IconBrush}" Visibility="{x:Bind FontGlyphVisibility}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{x:Bind NameVisibility}" />
                            <!-- VAULT-TOLERANT-01: "Unsupported" after a credential a newer version saved (in the row's UIA name too). -->
                            <TextBlock Text="{x:Bind Badge}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"
                                       Visibility="{x:Bind BadgeVisibility}" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Style="{StaticResource SectionHeaderTextStyle}" Visibility="{x:Bind GroupVisibility}"
                                       AutomationProperties.HeadingLevel="Level2" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Border>
</UserControl>
